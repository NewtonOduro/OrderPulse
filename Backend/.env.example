PORT=4000
NODE_ENV=development

# MySQL 8-compatible connection URL. Keep this private and enable TLS when required by your provider.
MYSQL_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
MYSQL_SSL=true
# Optional provider CA certificate in PEM format (Aiven: download from the service overview).
MYSQL_SSL_CA=
DATABASE_POOL_SIZE=5

# Set these three once in Render to create the first manager automatically on startup.
# Remove ADMIN_PASSWORD after the manager exists.
ADMIN_NAME=Restaurant Manager
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=

# Paystack secret key. Use a test key for development and the live key only in production.
PAYSTACK_SECRET_KEY=
PUBLIC_APP_URL=http://localhost:5173

# Domain-free email through a Gmail account and Gmail API OAuth refresh credentials.
# EMAIL_FROM is not needed for Gmail API; the sender is GMAIL_USER.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional staff inboxes for notifications.
STAFF_NOTIFICATION_EMAIL=
JOB_APPLICATION_NOTIFICATION_EMAIL=

# Optional alternatives. Prefer Gmail API when you do not own a sender domain.
RESEND_API_KEY=
EMAIL_FROM=
