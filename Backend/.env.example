PORT=4000
# PostgreSQL connection string. Neon URLs should include sslmode=require.
DATABASE_URL=
ADMIN_NAME=Restaurant Manager
ADMIN_EMAIL=manager@example.com
# Set a unique, randomly generated password locally. Never use a sample password.
ADMIN_PASSWORD=

# Resend HTTPS API works with Render's Free plan. Verify your sender domain in Resend.
RESEND_API_KEY=
EMAIL_FROM=OrderPulse <orders@your-verified-domain.com>

# Optional SMTP fallback for hosting providers that allow outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM is used as EMAIL_FROM when EMAIL_FROM is empty.
SMTP_FROM=
# Optional public URL for verification/reset links; Render's RENDER_EXTERNAL_URL is used when unset.
PUBLIC_APP_URL=

# Staff inbox for new order and reservation notifications.
STAFF_NOTIFICATION_EMAIL=

# Hiring inbox notified when a job application is submitted. The applicant's CV is attached.
JOB_APPLICATION_NOTIFICATION_EMAIL=

NEON_KEY=neon://
NEON_ACCESS_KEY=
DATABASE_URL=
