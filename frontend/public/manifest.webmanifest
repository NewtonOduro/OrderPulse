{
  "id": "/",
  "name": "OrderPulse Restaurant",
  "short_name": "OrderPulse",
  "description": "Order Ghanaian favourites and follow your restaurant orders with OrderPulse.",
  "start_url": "/",
  "scope": "/",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f7fa",
  "theme_color": "#18324b",
  "icons": [
    {
      "src": "/icons/orderpulse-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/orderpulse-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
